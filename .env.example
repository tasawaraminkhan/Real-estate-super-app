# =========================
# PropVerse Environment
# =========================

# Database (PostGIS)
DATABASE_URL=postgresql://propverse:propverse@localhost:5432/propverse?schema=public
POSTGRES_USER=propverse
POSTGRES_PASSWORD=propverse
POSTGRES_DB=propverse

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=propverse
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/propverse

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP (dev mode returns OTP in response)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=mock

# Maps
MAPBOX_TOKEN=pk.your_mapbox_token
GOOGLE_MAPS_API_KEY=

# App
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Feature flags
ESCROW_ENABLED=false
KYC_REQUIRED_FOR_PUBLISH=false

# Observability
SENTRY_DSN=
LOG_LEVEL=info
