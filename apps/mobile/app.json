{
  "expo": {
    "name": "PropVerse",
    "slug": "propverse",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "propverse",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0D6B5F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.propverse.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D6B5F"
      },
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "ios": {
      "bundleIdentifier": "com.propverse.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "propverse-local"
      }
    }
  }
}
