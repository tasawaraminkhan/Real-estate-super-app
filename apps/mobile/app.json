{
  "expo": {
    "name": "PropVerse",
    "slug": "propverse",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "propverse",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "description": "PropVerse — Pakistan real estate: buy, sell, rent, construction cost, legal checks, and leads in one app.",
    "primaryColor": "#0D6B5F",
    "splash": {
      "backgroundColor": "#0D6B5F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.propverse.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0D6B5F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.propverse.app"
    },
    "ios": {
      "bundleIdentifier": "com.propverse.app",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PropVerse uses your location to show nearby properties on the map.",
        "NSUserTrackingUsageDescription": "Not used. PropVerse does not track users across apps."
      }
    },
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "propverse-local"
      },
      "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
    },
    "privacy": "public"
  }
}
