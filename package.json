{
  "name": "propverse",
  "version": "0.1.0",
  "private": true,
  "description": "PropVerse — Pakistan Real Estate Super-App monorepo",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @propverse/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @propverse/api exec prisma db seed",
    "db:generate": "pnpm --filter @propverse/api exec prisma generate",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
