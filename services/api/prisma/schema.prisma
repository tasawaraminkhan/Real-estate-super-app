// PropVerse core schema — Phase 1
// PostGIS extensions + geography columns applied via raw SQL migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  BUYER
  OWNER
  AGENT
  AGENCY_ADMIN
  DEVELOPER
  CONTRACTOR
  ARCHITECT
  VENDOR
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PropertyPurpose {
  SALE
  RENT
  SHORT_STAY
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  AGRICULTURAL
  INDUSTRIAL
}

enum PropertyType {
  PLOT
  HOUSE
  FLAT
  SHOP
  OFFICE
  WAREHOUSE
  FARMHOUSE
  VILLA
  PORTION
  BUILDING
  AGRICULTURAL_LAND
}

enum ConstructionState {
  PLOT_ONLY
  GREY_STRUCTURE
  SEMI_FINISHED
  FINISHED
  UNDER_CONSTRUCTION
}

enum Possession {
  PHYSICAL
  FILE_ONLY
  UNDER_DEVELOPMENT
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD
  RENTED
  REJECTED
  EXPIRED
}

enum PriceType {
  FIXED
  NEGOTIABLE
  ON_CALL
}

enum AreaUnit {
  MARLA
  KANAL
  SQFT
  SQM
  SQYD
  ACRE
}

enum PlotStatus {
  AVAILABLE
  SOLD
  ON_HOLD
  FILE_ONLY
  POSSESSION
}

enum MediaType {
  PHOTO
  VIDEO
  TOUR_360
  DRONE
  FLOOR_PLAN
}

model User {
  id                 String             @id @default(uuid())
  phone              String             @unique
  email              String?            @unique
  passwordHash       String?            @map("password_hash")
  fullName           String?            @map("full_name")
  avatarUrl          String?            @map("avatar_url")
  role               UserRole           @default(BUYER)
  cnicEncrypted      String?            @map("cnic_encrypted")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  locale             String             @default("en")
  isActive           Boolean            @default(true) @map("is_active")
  lastLoginAt        DateTime?          @map("last_login_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  properties Property[] @relation("OwnerProperties")
  favourites Favourite[]

  @@map("users")
}

model Location {
  id        String    @id @default(uuid())
  name      String
  level     String // COUNTRY | PROVINCE | CITY | TEHSIL | SOCIETY | PHASE | BLOCK
  parentId  String?   @map("parent_id")
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children Location[] @relation("LocationTree")
  societies Society[]
  properties Property[]

  @@map("locations")
}

model Society {
  id             String    @id @default(uuid())
  name           String
  developerId    String?   @map("developer_id")
  cityId         String    @map("city_id")
  authority      String? // LDA, CDA, RDA, GDA, KDA, SBCA, PRIVATE
  approvalStatus String?   @map("approval_status")
  masterPlanUrl  String?   @map("master_plan_url")
  totalPlots     Int?      @map("total_plots")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  city       Location   @relation(fields: [cityId], references: [id])
  properties Property[]
  plots      Plot[]

  @@map("societies")
}

model Property {
  id                   String            @id @default(uuid())
  ownerId              String            @map("owner_id")
  agencyId             String?           @map("agency_id")
  purpose              PropertyPurpose
  category             PropertyCategory
  type                 PropertyType
  title                String
  description          String?
  societyId            String?           @map("society_id")
  cityId               String?           @map("city_id")
  addressText          String?           @map("address_text")
  // location geography(Point,4326) added via raw SQL
  latitude             Float?
  longitude            Float?
  areaValue            Float             @map("area_value")
  areaUnit             AreaUnit          @map("area_unit")
  bedrooms             Int?
  bathrooms            Int?
  floors               Int?
  constructionState    ConstructionState? @map("construction_state")
  possession           Possession?
  corner               Boolean           @default(false)
  parkFacing           Boolean           @default(false) @map("park_facing")
  priceAmount          BigInt            @map("price_amount") // minor units
  currency             String            @default("PKR") @db.Char(3)
  priceType            PriceType         @default(FIXED) @map("price_type")
  installmentAvailable Boolean           @default(false) @map("installment_available")
  downPayment          BigInt?           @map("down_payment")
  monthlyInstallment   BigInt?           @map("monthly_installment")
  installmentMonths    Int?              @map("installment_months")
  status               PropertyStatus    @default(DRAFT)
  isFeatured           Boolean           @default(false) @map("is_featured")
  isVerified           Boolean           @default(false) @map("is_verified")
  boostUntil           DateTime?         @map("boost_until")
  viewsCount           Int               @default(0) @map("views_count")
  publishedAt          DateTime?         @map("published_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  owner   User      @relation("OwnerProperties", fields: [ownerId], references: [id])
  society Society?  @relation(fields: [societyId], references: [id])
  city    Location? @relation(fields: [cityId], references: [id])
  media   PropertyMedia[]
  favourites Favourite[]
  leads      Lead[]

  @@index([cityId, purpose, status, priceAmount])
  @@index([societyId, status])
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("properties")
}

model PropertyMedia {
  id               String    @id @default(uuid())
  propertyId       String    @map("property_id")
  type             MediaType @default(PHOTO)
  url              String
  thumbnail        String?
  sortOrder        Int       @default(0) @map("sort_order")
  width            Int?
  height           Int?
  watermarkApplied Boolean   @default(false) @map("watermark_applied")
  altText          String?   @map("alt_text")
  createdAt        DateTime  @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_media")
}

model Plot {
  id         String     @id @default(uuid())
  societyId  String     @map("society_id")
  phase      String?
  block      String?
  plotNo     String     @map("plot_no")
  areaValue  Float      @map("area_value")
  areaUnit   AreaUnit   @map("area_unit")
  status     PlotStatus @default(AVAILABLE)
  listingId  String?    @map("listing_id")
  // geo geography(Polygon,4326) via raw SQL
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  society Society @relation(fields: [societyId], references: [id])

  @@unique([societyId, block, plotNo])
  @@map("plots")
}

model Favourite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favourites")
}

enum LeadStage {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum TransactionStatus {
  CREATED
  PENDING
  PAID
  REFUNDED
  FAILED
  EXPIRED
}

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  AGENCY
  DEVELOPER
}

model Lead {
  id             String    @id @default(uuid())
  propertyId     String    @map("property_id")
  buyerId        String?   @map("buyer_id")
  agentId        String?   @map("agent_id")
  stage          LeadStage @default(NEW)
  source         String?
  notes          String?
  buyerPhone     String?   @map("buyer_phone")
  buyerName      String?   @map("buyer_name")
  nextFollowupAt DateTime? @map("next_followup_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([agentId, stage])
  @@index([propertyId])
  @@map("leads")
}

model Plan {
  id              String   @id @default(uuid())
  code            PlanTier @unique
  name            String
  priceMonthly    BigInt   @map("price_monthly") // paisa
  maxListings     Int      @map("max_listings")
  maxPhotos       Int      @map("max_photos")
  maxSeats        Int      @default(1) @map("max_seats")
  featuredCredits Int      @default(0) @map("featured_credits")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  featuredCredits    Int                @default(0) @map("featured_credits")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  amount      BigInt
  currency    String            @default("PKR") @db.Char(3)
  status      TransactionStatus @default(CREATED)
  provider    String            @default("mock") // jazzcash | easypaisa | stripe | bank | mock
  providerRef String?           @map("provider_ref")
  purpose     String // subscription | featured | token_booking
  meta        Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("transactions")
}

model ConstructionRate {
  id           String   @id @default(uuid())
  material     String // cement | steel | bricks | sand | crush | labour_grey
  unit         String // bag | kg | no | cft | sqft
  priceMinor   BigInt   @map("price_minor") // paisa
  city         String   @default("DEFAULT")
  effectiveFrom DateTime @map("effective_from")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([material, city, effectiveFrom])
  @@map("construction_rates")
}

model FraudSignal {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  score      Int
  signals    Json
  action     String // auto_approve | hold | auto_hold
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@map("fraud_signals")
}

model MessageThread {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  buyerId    String   @map("buyer_id")
  sellerId   String   @map("seller_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  messages Message[]

  @@unique([propertyId, buyerId, sellerId])
  @@map("message_threads")
}

model Message {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  senderId  String   @map("sender_id")
  body      String
  type      String   @default("text")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("messages")
}
